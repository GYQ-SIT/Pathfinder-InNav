{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/GYQ-SIT/Pathfinder-InNav/docs/schemas/mobile-prototype.schema.json",
  "title": "InNavi phone prototype data",
  "description": "The made-up data of the design team's phone prototype (what -MobileMock shows and the phone screens' tests run on). Read by FMobileMockSource; described in docs/design/mobile-app-data-interface.md. It always says that it is synthetic.",
  "type": "object",
  "required": ["format", "version", "synthetic", "dataNote", "plan", "placeSets", "sites"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "innavi-mobile-prototype" },
    "version": { "const": 1 },
    "synthetic": { "description": "Must be true: made-up data says so, and a file that does not is refused.", "const": true },
    "dataNote": { "description": "The line the screens show to say that the data is simulated.", "type": "string", "minLength": 1 },
    "about": { "type": "string" },
    "placeDescription": { "type": "string" },
    "plan": {
      "description": "The schematic plan every level shares (0-100 each way).",
      "type": "object",
      "required": ["entrance", "crossing", "connectors", "levelOutline", "roomHalfSize"],
      "additionalProperties": false,
      "properties": {
        "entrance": { "$ref": "#/definitions/point" },
        "crossing": { "$ref": "#/definitions/point" },
        "connectors": {
          "type": "object",
          "required": ["lift", "stairs", "escalator"],
          "additionalProperties": false,
          "properties": {
            "lift": { "$ref": "#/definitions/point" },
            "stairs": { "$ref": "#/definitions/point" },
            "escalator": { "$ref": "#/definitions/point" }
          }
        },
        "levelOutline": { "$ref": "#/definitions/outline" },
        "roomHalfSize": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "placeSets": {
      "description": "The places every level of a site has, by set name.",
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/placeTemplate" } }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/site" }
    }
  },
  "definitions": {
    "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "outline": { "type": "array", "minItems": 3, "items": { "$ref": "#/definitions/point" } },
    "placeTemplate": {
      "type": "object",
      "required": ["name", "number", "category", "roomType", "position"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "number": { "description": "The door number: 101 is printed in the code of the place.", "type": "integer", "minimum": 0 },
        "category": { "type": "string", "minLength": 1 },
        "roomType": { "type": "string" },
        "position": { "$ref": "#/definitions/point" },
        "unavailableOnLevels": { "description": "Levels on which the place is shown as unavailable.", "type": "array", "items": { "type": "integer" } }
      }
    },
    "site": {
      "type": "object",
      "required": ["id", "name", "placeSet", "codePattern", "buildings"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string" },
        "subtitle": { "type": "string" },
        "distanceLabel": { "type": "string" },
        "hasEscalators": { "type": "boolean" },
        "placeSet": { "description": "A name in placeSets.", "type": "string", "minLength": 1 },
        "codePattern": { "description": "How the code on a door is written: {building}, {level} and {number} are replaced.", "type": "string", "pattern": "\\{number\\}" },
        "buildings": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/building" } },
        "campusMap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "buildings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["buildingId", "outline"],
                "additionalProperties": false,
                "properties": { "buildingId": { "type": "string", "minLength": 1 }, "outline": { "$ref": "#/definitions/outline" } }
              }
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "outline"],
                "additionalProperties": false,
                "properties": { "name": { "type": "string", "minLength": 1 }, "outline": { "$ref": "#/definitions/outline" } }
              }
            }
          }
        }
      }
    },
    "building": {
      "type": "object",
      "required": ["id", "name", "levels"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["level", "label"],
            "additionalProperties": false,
            "properties": { "level": { "type": "integer", "minimum": 1 }, "label": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
