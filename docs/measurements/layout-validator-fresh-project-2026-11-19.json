  "probe_source": {
    "Source/T11ValidatorProbe/T11ValidatorProbe.Build.cs": "using UnrealBuildTool;\npublic class T11ValidatorProbe : ModuleRules\n{\n    public T11ValidatorProbe(ReadOnlyTargetRules Target) : base(Target)\n    {\n        PCHUsage = PCHUsageMode.UseExplicitOrSharedPCHs;\n        PrivateDependencyModuleNames.AddRange(new[] { \"Core\", \"CoreUObject\", \"Engine\", \"InNaviLayoutValidator\" });\n    }\n}\n",
    "Source/T11ValidatorProbe/T11ValidatorProbe.cpp": "#include \"Modules/ModuleManager.h\"\nIMPLEMENT_PRIMARY_GAME_MODULE(FDefaultGameModuleImpl, T11ValidatorProbe, \"T11ValidatorProbe\");\n",
    "Source/T11ValidatorProbe.Target.cs": "using UnrealBuildTool;\npublic class T11ValidatorProbeTarget : TargetRules\n{\n    public T11ValidatorProbeTarget(TargetInfo Target) : base(Target)\n    {\n        Type = TargetType.Game;\n        DefaultBuildSettings = BuildSettingsVersion.V7;\n        IncludeOrderVersion = EngineIncludeOrderVersion.Unreal5_8;\n        ExtraModuleNames.AddRange(new[] { \"T11ValidatorProbe\" });\n    }\n}\n",
    "Source/T11ValidatorProbeEditor/T11ValidateCommandlet.cpp": "#include \"T11ValidateCommandlet.h\"\n#include \"LayoutValidation.h\"\n#include \"LayoutToolRegistry.h\"\n#include \"Dom/JsonObject.h\"\n#include \"HAL/FileManager.h\"\n#include \"Misc/EngineVersion.h\"\n#include \"Misc/FileHelper.h\"\n#include \"Misc/Parse.h\"\n#include \"Misc/Paths.h\"\n#include \"Modules/ModuleManager.h\"\n#include \"Serialization/JsonSerializer.h\"\n#include \"Serialization/JsonWriter.h\"\nIMPLEMENT_MODULE(FDefaultModuleImpl, T11ValidatorProbeEditor);\nUT11ValidateCommandlet::UT11ValidateCommandlet()\n{\n    IsClient = false; IsServer = false; IsEditor = true; LogToConsole = true;\n}\nint32 UT11ValidateCommandlet::Main(const FString& Params)\n{\n    FString Input, Output;\n    if (!FParse::Value(*Params, TEXT(\"Input=\"), Input) || !FParse::Value(*Params, TEXT(\"Report=\"), Output)) return 2;\n    if (FPaths::ConvertRelativePathToFull(Input).Equals(FPaths::ConvertRelativePathToFull(Output), ESearchCase::IgnoreCase)) return 2;\n    FModuleManager::LoadModuleChecked<IModuleInterface>(TEXT(\"InNaviLayoutValidator\"));\n    const auto Report = LayoutValidation::ValidateFile(Input);\n    if (!LayoutValidation::ExportReport(Report, Output)) return 2;\n    auto Meta = MakeShared<FJsonObject>();\n    const bool bSQLite = FModuleManager::Get().IsModuleLoaded(TEXT(\"SQLiteCore\")) || FModuleManager::Get().IsModuleLoaded(TEXT(\"SQLiteSupport\"));\n    const bool bProduct = FModuleManager::Get().IsModuleLoaded(TEXT(\"InNavi\"));\n    Meta->SetStringField(TEXT(\"engineVersion\"), FEngineVersion::Current().ToString());\n    Meta->SetBoolField(TEXT(\"sqliteModuleLoaded\"), bSQLite);\n    Meta->SetBoolField(TEXT(\"productModuleLoaded\"), bProduct);\n    Meta->SetBoolField(TEXT(\"productDataDirectoryExists\"), IFileManager::Get().DirectoryExists(*(FPaths::ProjectDir() / TEXT(\"Data\"))));\n    bool bRegistered = false;\n    FString WidgetPath;\n    for (const auto& Tool : LayoutTools::FRegistry::Get().Tools(LayoutTools::EScreen::Interior))\n    {\n        if (Tool.Id == TEXT(\"Validation\")) { bRegistered = true; WidgetPath = Tool.WidgetClassPath; }\n    }\n    Meta->SetBoolField(TEXT(\"validationProviderRegistered\"), bRegistered);\n    Meta->SetStringField(TEXT(\"validationWidgetClassPath\"), WidgetPath);\n    FString Text;\n    if (!FJsonSerializer::Serialize(Meta, TJsonWriterFactory<>::Create(&Text)) || !FFileHelper::SaveStringToFile(Text, *(Output + TEXT(\".meta.json\")))) return 2;\n    UE_LOG(LogTemp, Display, TEXT(\"T11 probe: %d errors, %d warnings; SQL=%d, product=%d, registered=%d\"), Report.Count(LayoutValidation::ESeverity::Error), Report.Count(LayoutValidation::ESeverity::Warning), bSQLite, bProduct, bRegistered);\n    if (bSQLite || bProduct || !bRegistered) return 3;\n    return Report.HasErrors() ? 1 : 0;\n}\n",
    "Source/T11ValidatorProbeEditor/T11ValidateCommandlet.h": "#pragma once\n#include \"Commandlets/Commandlet.h\"\n#include \"T11ValidateCommandlet.generated.h\"\nUCLASS()\nclass UT11ValidateCommandlet : public UCommandlet\n{\n    GENERATED_BODY()\npublic:\n    UT11ValidateCommandlet();\n    virtual int32 Main(const FString& Params) override;\n};\n",
    "Source/T11ValidatorProbeEditor/T11ValidatorProbeEditor.Build.cs": "using UnrealBuildTool;\npublic class T11ValidatorProbeEditor : ModuleRules\n{\n    public T11ValidatorProbeEditor(ReadOnlyTargetRules Target) : base(Target)\n    {\n        PCHUsage = PCHUsageMode.UseExplicitOrSharedPCHs;\n        PrivateDependencyModuleNames.AddRange(new[] { \"Core\", \"CoreUObject\", \"Engine\", \"Json\", \"InNaviLayoutValidator\" });\n    }\n}\n",
    "Source/T11ValidatorProbeEditor.Target.cs": "using UnrealBuildTool;\npublic class T11ValidatorProbeEditorTarget : TargetRules\n{\n    public T11ValidatorProbeEditorTarget(TargetInfo Target) : base(Target)\n    {\n        Type = TargetType.Editor;\n        DefaultBuildSettings = BuildSettingsVersion.V7;\n        IncludeOrderVersion = EngineIncludeOrderVersion.Unreal5_8;\n        ExtraModuleNames.AddRange(new[] { \"T11ValidatorProbe\", \"T11ValidatorProbeEditor\" });\n    }\n}\n"
  },
